<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed adaptive icon: the art fills the entire 108dp adaptive
     surface as the BACKGROUND layer, foreground is transparent. This
     matches the "no visible frame" look the user asked for and mirrors
     the reference EggRunnerAdventure icon, where the artist bakes the
     final composition into a single edge-to-edge asset instead of
     inseting it inside a solid backdrop. Under launcher masks
     (Pixel-circle, squircle, teardrop) only the extreme corners are
     trimmed; the composition centre (hexagon shields, crane hook) sits
     well inside the safe zone so it stays fully visible. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_art" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
