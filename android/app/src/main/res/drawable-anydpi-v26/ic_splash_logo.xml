<?xml version="1.0" encoding="utf-8"?>
<!-- Identical to mipmap-anydpi-v26/ic_launcher.xml. The Android 12+ splash only
     accepts an AdaptiveIconDrawable here; a flat PNG is silently ignored and the
     platform falls back to the launcher icon, which then looks clipped. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_art" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
